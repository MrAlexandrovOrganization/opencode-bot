# Telegram
BOT_TOKEN=your_telegram_bot_token_here
ROOT_ID=your_telegram_user_id_here

# Уровень логирования: debug / info / warn / error (регистр не важен, default info).
LOG_LEVEL=info
# Shared local Telegram Bot API server — defined once in
# infra/telegram-bot-api (TELEGRAM_API_ID / TELEGRAM_API_HASH live there, not
# here). Pointed at it by docker-compose:
#   TELEGRAM_LOCAL_API_URL=http://telegram-bot-api:8081
# Leave empty to use api.telegram.org directly.
TELEGRAM_LOCAL_API_URL=

# opencode-backend (шлюз) НЕ поднимается из этого репозитория — он живёт в
# отдельном репозитории (backends/opencode-backend) со своим CI и деплоем.
# Бот подключается к уже запущенному шлюзу.
#   В docker (на сети whisper-net) шлюз доступен как http://opencode-backend:8080
#   (BACKEND_BASE_URL переопределяется docker-compose.yml).
#   Для локального запуска бота вне docker — URL опубликованного шлюза,
#   например http://localhost:8091 (см. порт в backends/opencode-backend).
BACKEND_BASE_URL=http://localhost:8091
# Token to authenticate with the gateway. This is the gateway's ADMIN_TOKEN;
# должен совпадать с ADMIN_TOKEN запущенного шлюза.
BACKEND_TOKEN=

# Credentials for HTTP basic auth on the opencode server. Used by the
# opencode-server and opencode-backend services; set a password to secure it.
OPENCODE_USERNAME=opencode
OPENCODE_PASSWORD=

# Git identity the agent uses for commits (git config --global inside the
# opencode-server container).
GIT_USER_NAME=
GIT_USER_EMAIL=

# Optional GitHub push access for the agent (настраивается в
# scripts/entrypoint.sh внутри opencode-server). Задай один из двух способов:
#   1) SSH deploy-ключ (без пароля, write-доступ к нужным репозиториям):
#      смонтируй файл ключа в контейнер через volume в docker-compose.yml и
#      укажи путь внутри контейнера здесь.
# GIT_DEPLOY_KEY_PATH=/run/secrets/git_deploy_id_ed25519
GIT_DEPLOY_KEY_PATH=
#   2) GitHub PAT (fine-grained, contents:write на целевые репозитории) —
#      git-URL переписываются на HTTPS, SSH не нужен.
# GH_TOKEN=github_pat_xxx

# API key for the agent's websearch tool (Exa MCP). Without it searches fail
# with 403 from https://mcp.exa.ai/mcp. Get a key at https://exa.ai (free tier
# available). Empty = websearch will keep failing with 403.
EXA_API_KEY=

# Defaults applied to messages sent to opencode (via the gateway).
# Empty = server default, e.g. anthropic/claude-sonnet-4
OPENCODE_MODEL=
OPENCODE_AGENT=build

# How to handle permission requests (bash/edit/webfetch):
#   ask   — send a Telegram prompt with Allow/Always/Deny buttons (default)
#   allow — auto-approve everything (same as "always")
#   deny  — auto-reject everything
PERMISSION_MODE=ask

# How long a single request to opencode may run before it is aborted
OPENCODE_REQUEST_TIMEOUT=30m

# Voice transcription via the shared Whisper gRPC service (backends/transcriber).
# Leave empty to disable voice support. In docker-compose these are overridden
# to point at the whisper-ingress service on the whisper-net network.
WHISPER_GRPC_HOST=
WHISPER_GRPC_PORT=50053
