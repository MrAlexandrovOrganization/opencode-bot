# syntax=docker/dockerfile:1

# opencode server — standalone opencode binary from GitHub Releases.
# There is no official public image, so we download the release build.
ARG GO_VERSION=1.26.6
ARG OPENCODE_VERSION=v1.18.29

FROM golang:${GO_VERSION}-alpine AS tools

# Pinned via build args from the Makefile (single source of truth).
ARG PROTOC_GEN_GO_VERSION
ARG PROTOC_GEN_GRPC_VERSION

RUN apk add --no-cache ca-certificates git

ENV CGO_ENABLED=0

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    set -eux; \
    GOBIN=/out go install github.com/bufbuild/buf/cmd/buf@v1.67.0; \
    GOBIN=/out go install google.golang.org/protobuf/cmd/protoc-gen-go@${PROTOC_GEN_GO_VERSION}; \
    GOBIN=/out go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@${PROTOC_GEN_GRPC_VERSION}; \
    GOBIN=/out go install github.com/a-h/templ/cmd/templ@v0.3.1020; \
    GOBIN=/out go install github.com/pressly/goose/v3/cmd/goose@v3.19.2; \
    GOBIN=/out go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.13.1; \
    GOBIN=/out go install github.com/fullstorydev/grpcurl/cmd/grpcurl@v1.9.1

FROM ubuntu:24.04 AS download

ARG TARGETARCH
ARG OPENCODE_TARGET
ARG OPENCODE_VERSION

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl xz-utils \
    && rm -rf /var/lib/apt/lists/*

RUN case "${TARGETARCH}" in \
        amd64) default_target=linux-x64 ;; \
        arm64) default_target=linux-arm64 ;; \
        *) echo "Unsupported target architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && target="${OPENCODE_TARGET:-$default_target}" \
    && url="https://github.com/anomalyco/opencode/releases/download/${OPENCODE_VERSION}/opencode-${target}.tar.gz" \
    && curl -fsSL -o /tmp/opencode.tar.gz "$url" \
    && tar -xzf /tmp/opencode.tar.gz -C /usr/local/bin opencode \
    && chmod +x /usr/local/bin/opencode \
    && /usr/local/bin/opencode --version

FROM ubuntu:24.04

ARG TARGETARCH
ARG GO_VERSION=1.26.6

# Dev toolchain: make/gcc (build-essential), Python 3 + pip + poetry, jq for
# JSON, envsubst for the observability Makefiles, git+curl.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl git jq gettext-base \
        build-essential make \
        openssh-client \
        python3 python3-pip python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    # PEP 668 (externally-managed-environment) blocks plain `pip install`;
    # --break-system-packages installs poetry to /usr/local/bin for everyone.
    # web-forager = local DuckDuckGo MCP server for the agent's web search
    # (keyless alternative to the built-in Exa websearch tool).
    && pip3 install --no-cache-dir --break-system-packages poetry web-forager==3.0.1

# Go toolchain. apt's golang-go on 24.04 is Go 1.22 — too old for the projects
# here (notes-bot, ollama-bot, location need go >= 1.26), so install the
# official build.
RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-${TARGETARCH}.tar.gz" -o /tmp/go.tgz \
    && tar -C /usr/local -xzf /tmp/go.tgz \
    && rm /tmp/go.tgz

COPY --from=tools /out/buf /out/protoc-gen-go /out/protoc-gen-go-grpc \
    /out/templ /out/goose /out/golangci-lint /out/grpcurl /usr/local/bin/

COPY --from=download /usr/local/bin/opencode /usr/local/bin/opencode
# Entrypoint that sets git identity from GIT_USER_NAME / GIT_USER_EMAIL env.
COPY scripts/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Persisted opencode state lives in these XDG dirs (bind-mounted from the host
# in docker-compose.yml). /workspace is the project root the agent operates on.
ENV OPENCODE_DISABLE_AUTOUPDATE=1 \
    XDG_CONFIG_HOME=/mnt/config \
    XDG_DATA_HOME=/mnt/data \
    XDG_CACHE_HOME=/mnt/cache \
    PATH="/usr/local/go/bin:/home/ubuntu/go/bin:${PATH}"

# Go build/module caches land in the persistent /mnt/cache bind mount so
# repeated builds and tests survive container restarts. Tools the agent
# installs with `go install` go to /home/ubuntu/go/bin (ephemeral).
ENV GOPATH=/home/ubuntu/go \
    GOBIN=/home/ubuntu/go/bin \
    GOCACHE=/mnt/cache/go/build \
    GOMODCACHE=/mnt/cache/go/pkg/mod

# Run as the image's default `ubuntu` user (UID 1000), matching the host user
# (maxim) so bind-mounted host files keep their original ownership.
USER ubuntu
WORKDIR /workspace

EXPOSE 4096
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["serve", "--hostname", "0.0.0.0", "--port", "4096"]
